---
import Layout from '../layouts/Layout.astro';
import OvalPortrait from '../components/OvalPortrait.astro';
import Photo from '../components/Photo.astro';
import Sparkle from '../components/Sparkle.astro';

// ===== configuração da oferta: preço e link de WhatsApp ficam só aqui =====
const PRECO_MENTORIA = "R$897";
const WHATSAPP_URL = "https://wa.me/5534991670558?text=Oi%20Loren%2C%20vi%20sua%20p%C3%A1gina%20e%20quero%20saber%20mais%20sobre%20a%20mentoria";
const INSTAGRAM_URL = "https://www.instagram.com/bylorenmartins";

// lista de espera: com true, o preço some e os botões levam pro formulário da lista;
// cada inscrição chega no e-mail da chave do Web3Forms (a mesma do portfólio). Com false, volta o preço e o WhatsApp.
const LISTA_DE_ESPERA = true;
const WEB3FORMS_KEY = "3b64e019-f7bd-4370-a0eb-69ccf1a98da6";
const cta = LISTA_DE_ESPERA
  ? { href: "#lista-de-espera", label: "Entrar na lista de espera", target: undefined, rel: undefined }
  : { href: WHATSAPP_URL, label: "Falar com a Loren", target: "_blank", rel: "noopener noreferrer" };

const navLinks = [
  { href: "#como-funciona", label: "O formato" },
  { href: "#material", label: "Material" },
  { href: "#investimento", label: "Investimento" },
  { href: "#perguntas", label: "Perguntas" },
];

const audience = [
  "Quer começar no UGC, mas não sabe quais são os primeiros passos.",
  "Já fez cursos, mas ainda sente dificuldade em transformar o conhecimento em ações práticas.",
  "Quer sair das permutas e conquistar campanhas remuneradas.",
  "Tem dificuldade para se posicionar, apresentar seu diferencial e atrair marcas.",
  "Quer entender por que seu portfólio não gera oportunidades e como melhorar.",
];

const facts = [
  { value: "4 encontros", text: "individuais, por chamada de vídeo" },
  { value: "Suporte", text: "durante os 30 dias" },
];

const weekSteps = [
  { title: "Encontro individual", text: "Por chamada de vídeo, você e a Loren trabalham o momento em que você está." },
  { title: "Materiais personalizados", text: "Depois do encontro, você recebe um plano de ação, pronto pra aplicar." },
  { title: "Suporte", text: "Tirar uma dúvida, mostrar uma proposta, aprovar um roteiro antes de gravar: quem responde é a própria Loren." },
];

// ícones: caminhos SVG de traço, no viewBox 0 0 24 24
const method = [
  { title: "Diagnosticar", text: "Um olhar atento pro seu perfil: bio, portfólio e nicho prioritário.", icon: "M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM21 21l-4.3-4.3" },
  { title: "Ajustar", text: "O que precisa mudar vira próximos passos que cabem na sua rotina.", icon: "M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6" },
  { title: "Executar", text: "Você grava e aplica, com roteiros aprovados antes de gravar.", icon: "M3 8h18v12H3zM3 8l1.5-4.5 16 3L21 8M10 11.5v5l4.5-2.5z" },
  { title: "Otimizar", text: "Com feedback em cima do que você fez, ajusta e segue.", icon: "M21 12a9 9 0 1 1-2.6-6.4L21 8M21 3v5h-5" },
];

const methodTilt = ["lg:-rotate-1", "lg:rotate-1 lg:mt-3", "lg:-rotate-[0.6deg]", "lg:rotate-1 lg:mt-3"];

const buildTopics = [
  { title: "Posicionamento", text: "Nicho definido, bio certa no perfil e uma identidade visual com a sua cara." },
  { title: "Portfólio", text: "O que aproveitar do que você já gravou, ideias a partir da sua rotina e roteiros no seu jeito de falar." },
  { title: "Prospecção", text: "Como abordar as marcas, lista do seu nicho e plataformas de UGC pra se candidatar." },
  { title: "Rotina", text: "Uma semana organizada, com blocos de gravação que cabem na sua agenda." },
];

const bonuses = [
  { title: "Como ganhar em dólar e começar no nicho tech", text: "O caminho pra fechar campanhas com marcas de fora e entrar no nicho de tecnologia.", icon: "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM2 12h20M12 2c3 3 4 6 4 10s-1 7-4 10c-3-3-4-6-4-10s1-7 4-10z" },
  { title: "Template de roteiro que as marcas amam", text: "Uma estrutura pronta pra adaptar ao seu jeito de falar.", icon: "M6 2h9l4 4v16H6zM14 2v5h5M9 12h7M9 16h7" },
  { title: "Pack de mensagens e prompts", text: "Mensagens pra falar com as marcas e comandos prontos pra usar com IA.", icon: "M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.6A8.4 8.4 0 1 1 21 11.5z" },
];
const bonusTilt = ["lg:-rotate-1", "lg:rotate-[0.8deg] lg:mt-2.5", "lg:-rotate-[0.6deg]"];

const included = [
  "4 encontros individuais",
  "Suporte direto com a Loren durante os 30 dias",
  "Análise completa do perfil",
  "Análise do posicionamento",
  "Diagnóstico do conteúdo",
  "Revisão do portfólio",
  "Estrutura de abordagem",
  "Cronograma de conteúdo",
  "Plano de ação personalizado",
];

const topBar = "Para quem quer monetizar criando conteúdo";

// prints de feedback: só reais e autorizados, sem dados que identifiquem quem não autorizou.
// Salve em public/images/feedbacks/ e preencha `src`; `src` vazio mostra um espaço reservado.
// Os feedback-*.png já vêm com moldura e sombra, sem foto e sem nome das alunas: aparecem inteiros, sem borda extra.
const feedbackPrints: { src: string; alt: string; w?: number; h?: number }[] = [
  { src: "/images/feedbacks/feedback-01.png", w: 708, h: 1154, alt: "Print da Rulya Pimentel, aprovada em 1 mês: \"Miga, eu fui aprovada na minha primeira campanha\"" },
  { src: "/images/feedbacks/feedback-02.png", w: 708, h: 1008, alt: "Print da Barbara Jandes, aprovada em 1 mês: \"Fechei minha primeira parceria\" e \"Passei na fase teste e vou ganhar em DÓLARRR!!!\"" },
  { src: "/images/feedbacks/feedback-03.png", w: 708, h: 1106, alt: "Print da Sarah Carvalho, que com 60 seguidores fechou parcerias em dólar: proposta com fixo mensal de U$ 200,00 e \"Tenho que gravar 2 vídeos pra eles hoje\"" },
  { src: "/images/feedbacks/feedback-04.png", w: 708, h: 952, alt: "Print da Thais Carvalho, primeira aprovação depois do 1º encontro: \"Publi de R$ 202,39 te esperando!\", \"LOREN, eu nem tô acreditando que é real\" e \"Isso é combustível pra quando eu duvidar de mim\"" },
  { src: "/images/feedbacks/feedback-05.png", w: 708, h: 718, alt: "Print da Anna Lacerda, 2 campanhas aprovadas em menos de 1 mês: \"FUI APROVADA EM MAIS UMA\"" },
  { src: "/images/feedbacks/feedback-06.png", w: 708, h: 828, alt: "Print da Lara Rocha, com post viralizado de +38 mil views: \"Recebi um e-mail de uma parceria estrangeira!!\" e uma agência oferecendo parceria com 3 restaurantes e cafés" },
  { src: "/images/feedbacks/feedback-07.png", w: 708, h: 854, alt: "Print da Karina Santos, evolução nítida nos vídeos: \"hoje junto com você eu realmente estou vendo evolução\"" },
  { src: "/images/feedbacks/feedback-08.png", w: 708, h: 782, alt: "Print da Beatriz, 2 abordagens com retorno em 1 semana: \"Uma das abordagens já deu certo\"" },
];

const faq = [
  { q: "O que é UGC?", a: "É o conteúdo que você cria pra uma marca usar nos canais dela, como anúncios e redes sociais. O vídeo não precisa sair no seu perfil." },
  { q: "Preciso ter muitos seguidores ou já ter feito campanhas?", a: "Não. No UGC, a marca está contratando o vídeo que você cria, e a Loren mesma fechou parcerias antes de ter mil seguidores. A mentoria também é pra quem ainda não fez nenhuma campanha: o trabalho começa pelo diagnóstico do seu perfil." },
  { q: "Já trabalho com marcas. Faz sentido pra mim?", a: "Faz. A mentoria também é pra quem já produz e quer se profissionalizar. O trabalho muda conforme o seu momento: em vez de primeiros passos, o foco vai pro que precisa evoluir hoje." },
  { q: "Como funcionam os encontros e o suporte?", a: "São 4 chamadas de vídeo individuais ao longo de 30 dias, em datas combinadas com você, a partir do que é prioridade pra você naquele momento. Depois, você recebe um material com o que foi trabalhado. Nos 30 dias, você fala direto com a Loren pelo WhatsApp pra tirar dúvidas, mostrar uma proposta e aprovar roteiros antes de gravar. Os encontros são pelo Google Meet e duram de 1h a 1h30." },
  { q: "Trabalho ou estudo o dia todo. Consigo acompanhar?", a: "Sim. O UGC permite produzir à noite ou nos fins de semana, sem horário fixo, então pode ser uma renda extra sem largar o emprego. E os encontros podem ser marcados em horários flexíveis." },
  { q: "Funciona pra qualquer nicho ou só pra beleza e maquiagem?", a: "Pra todos. Marcas de apps, finanças, pet, comida, decoração e serviços também precisam de vídeos humanizados, e o método de prospecção serve pra qualquer segmento." },
  { q: "Não sei fazer edições complexas. Preciso ser expert?", a: "Não. As marcas buscam conteúdo autêntico, não produção de cinema. Edições simples, em apps gratuitos como o CapCut e com foco em prender a atenção, já resolvem." },
];

const primaryButton = "inline-flex min-h-12 items-center justify-center rounded-full bg-wine px-7 py-3.5 text-center font-semibold text-offwhite transition-transform hover:-translate-y-0.5";
// grifo de marca-texto sob as palavras em itálico dos títulos
const marker = "bg-[linear-gradient(transparent_68%,var(--color-rose)_68%)]";
const sectionTitle = "font-display text-[clamp(2.25rem,4vw,3.5rem)] leading-[1.05] text-wine";
---

<Layout
  title="Mentoria UGC com Loren Martins"
  description="Mentoria individual: 4 encontros individuais por chamada de vídeo, material feito só pra você depois de cada conversa e suporte durante 30 dias."
  image="/images/mentoria-og.jpg"
>
  <div class="marquee overflow-hidden bg-wine py-2 text-sm font-medium text-offwhite">
    <div class="marquee-track flex w-max" style="animation-duration: 45s;">
      {[0, 1].map((copy) => (
        <ul aria-hidden={copy === 1 ? "true" : undefined} class="flex shrink-0 items-center">
          {Array.from({ length: 8 }, () => (
            <li class="flex items-center gap-6 pr-6 whitespace-nowrap">
              {topBar}
              <Sparkle class="h-3 w-3 text-rose" />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <header class="sticky top-0 z-30 border-b border-wine/15 bg-offwhite/90 backdrop-blur">
    <div class="mx-auto flex max-w-[1320px] items-center justify-between gap-6 px-6 py-3">
      <a href="/" class="font-display text-xl whitespace-nowrap text-wine italic sm:text-2xl">Loren Martins</a>
      <nav aria-label="Seções da página" class="hidden items-center gap-7 text-[15px] font-medium lg:flex">
        {navLinks.map((l) => <a href={l.href} class="text-wine hover:text-wine-deep">{l.label}</a>)}
      </nav>
      <div class="flex items-center gap-5">
        <a href="/" class="text-[15px] font-medium text-wine hover:text-wine-deep">Portfólio</a>
        <a href={cta.href} target={cta.target} rel={cta.rel} class="hidden rounded-full bg-wine px-5 py-2.5 text-sm font-semibold text-offwhite transition-transform hover:-translate-y-0.5 sm:block">{cta.label}</a>
      </div>
    </div>
  </header>

  <main class="overflow-x-clip">
    <!-- HERO -->
    <section class="mx-auto grid max-w-[1320px] items-center gap-8 px-6 pt-8 md:min-h-[min(calc(100svh-6.75rem),860px)] md:grid-cols-[3fr_2fr]">
      <div class="flex flex-col gap-4 md:pb-8">
        <div data-reveal class="flex flex-wrap gap-2">
          <span class="rounded-full bg-rose px-3.5 py-1.5 text-xs font-semibold tracking-[0.08em] uppercase">Mentoria individual</span>
          <span class="rounded-full bg-sky px-3.5 py-1.5 text-xs font-semibold tracking-[0.08em] uppercase">30 dias</span>
        </div>
        <h1 data-reveal style="--reveal-delay: 80ms;" class="font-display text-[clamp(2.5rem,min(5.6vw,11vh),5rem)] leading-[1] text-wine">
          Monetize seu conteúdo do jeito que <span class="italic">cabe na sua rotina.</span>
        </h1>
        <p data-reveal style="--reveal-delay: 140ms;" class="max-w-xl text-lg leading-relaxed text-wine-soft">
          Mentoria individual: diagnóstico, direção e material feito só pra você, com suporte durante toda a mentoria.
        </p>
        <div data-reveal style="--reveal-delay: 200ms;" class="mt-2 flex flex-wrap items-center gap-3">
          <a href={cta.href} target={cta.target} rel={cta.rel} class={primaryButton}>{cta.label}</a>
          <a href="#como-funciona" class="inline-flex min-h-12 items-center justify-center rounded-full border-[1.5px] border-wine px-7 py-3.5 font-semibold text-wine transition-transform hover:-translate-y-0.5">Ver como funciona</a>
        </div>
      </div>
      <div data-reveal style="--reveal-delay: 120ms;" class="flex justify-center md:self-end">
        <div class="relative aspect-[4/5] w-full max-w-[420px] md:max-w-[min(100%,calc((100svh-6.75rem-2rem)*0.8),640px)]">
          <div aria-hidden="true" class="stripes absolute inset-0 translate-x-3 rounded-t-[50%_40%] border-x-[1.5px] border-t-[1.5px] border-wine" style="--stripe-w: 22px; --stripe-angle: 270deg;"></div>
          <div class="absolute inset-0 overflow-hidden rounded-t-[50%_40%] border-x-[1.5px] border-t-[1.5px] border-wine bg-sky">
            <Photo src="/images/loren.webp" alt="Loren Martins sorrindo, com a mão apoiada no rosto" class="h-full w-full" eager />
          </div>
        </div>
      </div>
    </section>

    <!-- PRA QUEM É -->
    <section class="border-t-[1.5px] border-wine"><div class="mx-auto grid max-w-[1320px] gap-10 px-6 py-14 sm:py-20 md:grid-cols-2 lg:gap-16">
      <h2 data-reveal class={sectionTitle}>Essa mentoria é <span class={`italic ${marker}`}>para você que...</span></h2>
      <ul class="border-b-[1.5px] border-wine">
        {audience.map((item, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 50}ms;`} class="group flex items-start gap-4 border-t-[1.5px] border-wine px-2 py-5 first:border-t-0 transition-colors hover:bg-rose">
            <Sparkle class="mt-1.5 h-4 w-4 shrink-0 text-wine transition-transform group-hover:rotate-45" />
            <span class="font-display text-[clamp(1.25rem,2vw,1.5rem)] leading-snug text-wine-deep">{item}</span>
          </li>
        ))}
      </ul>
    </div></section>

    <!-- O FORMATO -->
    <section id="como-funciona" class="scroll-mt-20 border-y-[1.5px] border-wine bg-rose py-14 sm:py-20">
      <div class="mx-auto max-w-[1320px] px-6">
        <div data-reveal class="hard-shadow overflow-hidden rounded-[32px] border-[1.5px] border-wine bg-offwhite">
          <div class="grid md:grid-cols-[3fr_2fr]">
            <div class="flex flex-col justify-center gap-5 px-7 py-10 sm:px-12 sm:py-14">
              <h2 class={sectionTitle}>O <span class={`italic ${marker}`}>formato</span></h2>
              <p class="max-w-xl text-lg leading-relaxed text-wine-soft">
                Nada de aula pronta pra assistir e se virar depois. Durante 30 dias, você tem 4 encontros individuais por chamada de vídeo, em datas combinadas com você, e cada conversa parte do seu perfil, do seu nicho e da sua rotina. Cada encontro segue o mesmo ritmo:
              </p>
            </div>
            <div class="border-t-[1.5px] border-wine bg-sky px-7 py-9 sm:px-10 md:border-t-0 md:border-l-[1.5px]">
              <h3 class="mb-6 text-xs font-semibold tracking-[0.14em] text-wine uppercase">A cada encontro</h3>
              <ol class="flex flex-col">
                {weekSteps.map((step, i) => (
                  <li class="relative flex gap-4 pb-7 last:pb-0">
                    {i < weekSteps.length - 1 && <span aria-hidden="true" class="absolute top-10 bottom-1 left-[18px] border-l-[1.5px] border-dashed border-wine/50"></span>}
                    <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-[1.5px] border-wine bg-offwhite text-xs font-semibold text-wine shadow-[2px_2px_0_var(--color-wine)]">{String(i + 1).padStart(2, "0")}</span>
                    <div class="flex flex-col gap-1">
                      <h4 class="font-display text-[22px] leading-tight text-wine">{step.title}</h4>
                      <p class="leading-snug">{step.text}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          </div>
          <dl class="grid border-t-[1.5px] border-wine bg-rose/40 sm:grid-cols-2">
            {facts.map((item, i) => (
              <div class={`flex flex-wrap items-baseline justify-center gap-x-2 px-4 py-4 text-center ${i ? "border-t-[1.5px] border-wine sm:border-t-0 sm:border-l-[1.5px]" : ""}`}>
                <dt class="order-2 text-sm text-wine-deep">{item.text}</dt>
                <dd class="order-1 font-display text-xl text-wine italic">{item.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- MÉTODO -->
    <section id="metodo" class="mx-auto flex max-w-[1320px] scroll-mt-[4.5rem] flex-col justify-center gap-10 px-6 py-14 sm:py-16 lg:min-h-[calc(100svh-4.5rem)] lg:gap-8 lg:py-10">
      <div class="flex flex-col items-center gap-3 text-center">
        <span data-reveal class="rounded-full border-[1.5px] border-wine px-3.5 py-1.5 text-xs font-semibold tracking-[0.08em] text-wine uppercase">O método</span>
        <h2 data-reveal style="--reveal-delay: 60ms;" class={sectionTitle}>Quatro etapas, <span class={`italic ${marker}`}>um caminho só seu</span></h2>
        <p data-reveal style="--reveal-delay: 100ms;" class="mt-1 max-w-2xl text-lg leading-relaxed text-wine-soft">Um processo claro, do olhar pro seu perfil ao ajuste do que você já colocou em prática.</p>
      </div>
      <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
        {method.map((step, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 90}ms;`} class={`relative flex flex-col gap-3 overflow-hidden rounded-[22px] border-[1.5px] border-wine p-6 shadow-[5px_5px_0_var(--color-wine)] sm:p-8 lg:min-h-[380px] ${i % 2 ? "bg-sky" : "bg-rose"} ${methodTilt[i]}`}>
            <span aria-hidden="true" class="pointer-events-none absolute -top-1 right-3 font-display text-[96px] leading-none font-semibold text-wine/15">{String(i + 1).padStart(2, "0")}</span>
            <span aria-hidden="true" class="relative mb-3 flex h-16 w-16 items-center justify-center rounded-full border-[1.5px] border-wine bg-offwhite text-wine shadow-[3px_3px_0_var(--color-wine)]">
              <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={step.icon} /></svg>
            </span>
            <span class="text-xs font-semibold tracking-[0.14em] text-wine uppercase">Etapa {i + 1}</span>
            <h3 class="font-display text-[32px] leading-tight text-wine">{step.title}</h3>
            <p class="text-lg leading-relaxed text-wine-deep">{step.text}</p>
          </li>
        ))}
      </ol>
      <p data-reveal class="text-center text-sm font-semibold tracking-[0.08em] text-wine-soft uppercase">
        Pronta pra começar? <a href={cta.href} target={cta.target} rel={cta.rel} class="ml-1 text-wine underline underline-offset-4">{cta.label} →</a>
      </p>
    </section>

    <!-- SUA MENTORA -->
    <section id="sobre" class="stripes scroll-mt-20 border-y-[1.5px] border-wine px-6 py-14 sm:py-16">
      <div data-reveal class="hard-shadow mx-auto grid max-w-5xl items-center gap-10 rounded-[40px] border-[1.5px] border-wine bg-offwhite px-7 py-10 sm:px-12 sm:py-12 max-md:grid-cols-1 max-md:gap-6 md:grid-cols-2">
        <div class="flex flex-col gap-5 max-md:contents">
          <div class="flex items-center gap-4 max-md:order-1">
            <span aria-hidden="true" class="relative h-16 w-[72px] shrink-0">
              <Sparkle class="sparkle-animate absolute top-1 left-0 h-12 w-12 text-wine" style="--sparkle-dur: 2.4s; --sparkle-delay: 0s;" />
              <Sparkle class="sparkle-animate absolute top-0 right-0 h-4 w-4 text-sky" outline style="--sparkle-dur: 1.8s; --sparkle-delay: 0.4s;" />
              <Sparkle class="sparkle-animate absolute right-0.5 bottom-0 h-5 w-5 text-rose" outline style="--sparkle-dur: 2.6s; --sparkle-delay: 0.9s;" />
            </span>
            <h2 class={sectionTitle}>Sua <span class="italic">mentora</span></h2>
          </div>
          <div class="flex flex-col gap-5 max-md:order-3 md:contents">
          <p class="text-lg leading-relaxed">
            Sou Loren Martins, criadora UGC e especialista em <strong class="text-wine">cases virais e de performance</strong>, com <strong class="text-wine">mais de 60 marcas nacionais e internacionais</strong> atendidas.
          </p>
          <p class="text-lg leading-relaxed">
            Uno estratégia, criatividade e conhecimento de plataformas para desenvolver conteúdos que prendem a atenção, despertam interesse e ajudam marcas a alcançar seus objetivos.
          </p>
          <p class="text-lg leading-relaxed">
            Comecei no UGC enquanto <strong class="text-wine">ainda trabalhava CLT</strong> e conquistei minhas primeiras parcerias <strong class="text-wine">antes dos mil seguidores</strong>. Hoje, recebo inbounds de marcas todos os dias e ensino outras creators a aplicar, na prática, as estratégias que me trouxeram até aqui.
          </p>
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="w-fit font-semibold text-wine underline underline-offset-4">@bylorenmartins</a>
          </div>
        </div>
        <div class="flex justify-center max-md:order-2 max-md:pt-8">
          <OvalPortrait src="/images/mentoria-sobre.jpg" alt="Loren Martins sorrindo enquanto olha para o celular, de blazer bege" arcText="quem vai te acompanhar" arcOffset={14} />
        </div>
      </div>
    </section>

    <!-- O QUE A GENTE CONSTRÓI -->
    <section id="material" class="scroll-mt-20 border-t-[1.5px] border-wine">
      <div aria-hidden="true" class="stripes h-5 border-b-[1.5px] border-wine" style="--stripe-a: var(--color-wine); --stripe-w: 20px;"></div>
