          </div>
        </div>
        <div class="flex flex-col items-center justify-center gap-5 border-t-[1.5px] border-wine px-7 py-10 text-center sm:px-12 sm:py-12 md:border-t-0 md:border-l-[1.5px]">
          <h2 class="flex items-center gap-3 text-sm font-semibold tracking-[0.14em] text-wine uppercase">
            <Sparkle class="sparkle-animate h-5 w-5 text-wine" style="--sparkle-dur: 2.4s;" />
            Investimento
            <Sparkle class="sparkle-animate h-5 w-5 text-wine" style="--sparkle-dur: 2.8s; --sparkle-delay: 0.5s;" />
          </h2>
          {LISTA_DE_ESPERA ? (
            <div id="lista-de-espera" class="flex w-full scroll-mt-28 flex-col gap-5">
              <p class="font-display text-[clamp(2rem,4vw,2.75rem)] leading-[1.05] text-wine">Vagas abertas <span class="italic">em breve</span></p>
              <p class="leading-relaxed text-wine-soft">Entre na lista de espera e a Loren te chama no WhatsApp quando as vagas abrirem, com o valor e todos os detalhes.</p>
              <form data-lead-form action="https://api.web3forms.com/submit" method="POST" class="flex flex-col gap-3.5 text-left">
                <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
                <input type="hidden" name="subject" value="Lista de espera da mentoria" />
                <p hidden><label>Não preencha <input name="botcheck" /></label></p>
                <label class="flex flex-col gap-1.5 text-[13px] font-semibold tracking-[0.04em]">Seu nome<input required name="nome" autocomplete="name" class="min-h-12 w-full rounded-xl border-[1.5px] border-wine/30 bg-white px-4 text-base font-normal text-wine-deep focus:border-wine focus:outline-none" /></label>
                <label class="flex flex-col gap-1.5 text-[13px] font-semibold tracking-[0.04em]">WhatsApp<input required type="tel" inputmode="tel" name="whatsapp" autocomplete="tel" placeholder="(11) 91234-5678" data-br-phone data-invalid-msg="Digite um WhatsApp válido com DDD, ex.: (11) 91234-5678." class="min-h-12 w-full rounded-xl border-[1.5px] border-wine/30 bg-white px-4 text-base font-normal text-wine-deep placeholder:text-wine-soft/60 focus:border-wine focus:outline-none" /></label>
                <label class="flex flex-col gap-1.5 text-[13px] font-semibold tracking-[0.04em]"><span>Seu @ no Instagram ou TikTok <span class="font-normal text-wine-soft">(opcional)</span></span><input name="perfil" placeholder="@seuperfil" class="min-h-12 w-full rounded-xl border-[1.5px] border-wine/30 bg-white px-4 text-base font-normal text-wine-deep placeholder:text-wine-soft/60 focus:border-wine focus:outline-none" /></label>
                <button type="submit" class={`${primaryButton} mt-1 w-full`}>Entrar na lista de espera</button>
                <p data-form-error hidden class="text-sm">Não consegui enviar agora. Me chama no <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="underline">WhatsApp</a>.</p>
                <p class="text-center text-xs text-wine-soft">Sem e-mails: o contato é só pelo WhatsApp.</p>
              </form>
              <p data-form-success hidden class="font-display text-2xl leading-snug text-wine">Pronto, você está na lista! 💌 <span class="block pt-2 font-body text-base text-wine-soft">Quando as vagas abrirem, a Loren te chama no WhatsApp.</span></p>
            </div>
          ) : (
            <>
              <p class="font-display text-[clamp(4rem,8vw,6.5rem)] leading-none text-wine">{PRECO_MENTORIA}</p>
              <p class="text-sm font-semibold tracking-[0.1em] text-wine-soft uppercase">Pix ou cartão*</p>
              <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class={`${primaryButton} w-full`}>Falar com a Loren</a>
