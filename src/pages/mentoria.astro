  <!-- CTA FINAL -->
  <footer class="bg-wine text-offwhite">
    <div aria-hidden="true" class="h-7" style="background: repeating-linear-gradient(90deg, #F4C9D2 0 40px, #BFD9EE 40px 80px, #FAF6EF 80px 120px);"></div>
    <div class="mx-auto flex max-w-[1320px] flex-col items-center gap-6 px-6 pt-14 pb-12 text-center sm:pt-20 sm:pb-16">
      <h2 data-reveal class="font-display text-[clamp(2.25rem,4vw,3.5rem)] leading-[1.05] max-w-4xl text-rose">Você pode continuar tentando adivinhar o que falta. <span class="text-sky italic">Ou perguntar pra quem já passou por isso.</span></h2>
      <a data-reveal style="--reveal-delay: 80ms;" href={cta.href} target={cta.target} rel={cta.rel} class="inline-flex min-h-12 items-center justify-center rounded-full bg-rose px-8 py-3.5 font-semibold text-wine transition-transform hover:-translate-y-0.5 focus-visible:outline-offwhite">{LISTA_DE_ESPERA ? `${cta.label} →` : `Falar com a Loren · ${PRECO_MENTORIA} →`}</a>
      <p data-reveal style="--reveal-delay: 140ms;" class="font-semibold">Vagas limitadas.</p>
    </div>
    <div class="mx-auto flex max-w-[1320px] flex-wrap items-center justify-between gap-4 border-t border-offwhite/25 px-6 pt-6 pb-24 text-sm md:pb-8">
      <span>© Loren Martins</span>
      <span class="flex gap-5">
        <a href="/" class="underline underline-offset-4 focus-visible:outline-offwhite">Portfólio</a>
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 focus-visible:outline-offwhite">@bylorenmartins</a>
      </span>
    </div>
  </footer>

  <script>
    import { initCoverflow } from "../scripts/coverflow";

    // bônus no celular: carrossel; no desktop os 3 cards ficam lado a lado e nada disso roda
    const list = document.querySelector<HTMLElement>("[data-bonus-carousel]");
    const dotsBox = document.querySelector<HTMLElement>("[data-bonus-dots]");
    const prevBtn = document.querySelector<HTMLElement>("[data-bonus-prev]");
    const nextBtn = document.querySelector<HTMLElement>("[data-bonus-next]");
    if (list && dotsBox && prevBtn && nextBtn) {
      initCoverflow({ list, dotsBox, prevBtn, nextBtn, mobileQuery: "(max-width: 767px)", dotLabel: "Bônus" });
    }

    // telefone BR: máscara (11) 91234-5678 e validação de DDD, 9º dígito e número repetido
    const DDDS = new Set("11 12 13 14 15 16 17 18 19 21 22 24 27 28 31 32 33 34 35 37 38 41 42 43 44 45 46 47 48 49 51 53 54 55 61 62 63 64 65 66 67 68 69 71 73 74 75 77 79 81 82 83 84 85 86 87 88 89 91 92 93 94 95 96 97 98 99".split(" "));
    const nationalDigits = (value: string) => {
      let d = value.replace(/\D/g, "");
      if (d.length > 11 && d.startsWith("55")) d = d.slice(2);
      return d.slice(0, 11);
    };
    const isValidBrPhone = (d: string) => {
      if (!DDDS.has(d.slice(0, 2))) return false;
      const number = d.slice(2);
      if (/^(\d)\1+$/.test(number)) return false;
      if (d.length === 11) return number[0] === "9";
      if (d.length === 10) return /[2-5]/.test(number[0]);
      return false;
    };
    document.querySelectorAll<HTMLInputElement>("input[data-br-phone]").forEach((input) => {
      input.addEventListener("input", () => {
        const d = nationalDigits(input.value);
        const split = d[2] === "9" ? 7 : 6;
        input.value = d.length > 6 ? `(${d.slice(0, 2)}) ${d.slice(2, split)}-${d.slice(split)}` : d.length > 2 ? `(${d.slice(0, 2)}) ${d.slice(2)}` : d;
        input.setCustomValidity(isValidBrPhone(d) ? "" : input.dataset.invalidMsg ?? "");
      });
    });

    // lista de espera (Web3Forms): a inscrição chega no e-mail da Loren sem sair da página
    document.querySelectorAll<HTMLFormElement>("[data-lead-form]").forEach((form) => {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const error = form.querySelector<HTMLElement>("[data-form-error]");
        const success = form.parentElement?.querySelector<HTMLElement>("[data-form-success]");
        if (button) button.disabled = true;
        if (error) error.hidden = true;
        try {
          const res = await fetch(form.action, {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          const data = await res.json();
          if (!res.ok || !data.success) throw new Error(data.message || String(res.status));
          form.hidden = true;
          if (success) success.hidden = false;
        } catch {
          if (error) error.hidden = false;
          if (button) button.disabled = false;
        }
      });
    });
  </script>

  <!-- botão fixo no celular -->
  <a href={cta.href} target={cta.target} rel={cta.rel} class="fixed right-4 bottom-4 z-40 flex min-h-12 items-center rounded-full border-[1.5px] border-offwhite bg-wine px-5 text-sm font-semibold text-offwhite shadow-lg md:hidden">{cta.label}</a>
