          <details data-reveal style={`--reveal-delay: ${i * 50}ms;`} class="group rounded-[20px] border-[1.5px] border-wine bg-offwhite transition-shadow open:bg-rose/30 open:shadow-[4px_4px_0_var(--color-wine)]">
