---
import Layout from '../layouts/Layout.astro';
import Sparkle from '../components/Sparkle.astro';

// ===== mídia kit: todos os números ficam aqui, com a data da coleta =====
// fonte: Insights do Instagram @bylorenmartins (versão web), coletados em DATA_COLETA
const DATA_COLETA = "17/11/2026";
const WHATSAPP = "5534991670558";
const EMAIL = "contatolorenmartins@gmail.com";

const niches = ["Moda", "Experiências", "Tech", "Acessórios", "Beleza", "Bem-estar & fit", "Bebidas & drinks", "Pet"];

// visão geral dos últimos 30 dias
const stats = [
  { value: "268,6 mil", label: "views" },
  { value: "79,3 mil", label: "contas alcançadas" },
  { value: "52,5%", label: "das views vieram de quem ainda não me segue" },
  { value: "8,26%", label: "de engajamento médio nos Reels" },
  { value: "5,5 mil", label: "visitas ao perfil" },
  { value: "12,6 mil", label: "interações" },
];

// destaques: só números vistos nos insights de cada Reel
const highlights = [
  { title: "Reel mais visto", detail: "ago/2026", numbers: ["115,6 mil views", "89,6 mil contas alcançadas", "2,6 mil compartilhamentos"] },
  { title: "Boh Gastronomia", detail: "collab", numbers: ["35,9 mil views", "520 compartilhamentos"] },
  { title: "Mirante", detail: "parceria paga", numbers: ["33 mil views", "24,1 mil contas alcançadas"] },
  { title: "Jamile Confeitaria", detail: "collab", numbers: ["16,9 mil views", "645 compartilhamentos"] },
  { title: "Disney+", detail: "parceria paga", numbers: ["16,1 mil views"] },
];

// público: preencha com os prints do app (Painel profissional > Insights > Público); vazio, a parte some
const audience: { label: string; items: string[] }[] = [];

const logos = [
  ["Philips", "philips.png"], ["KitKat", "kitkat.png"], ["Dove", "dove.png"], ["Disney+", "disney-plus.png"],
  ["Neutrogena", "neutrogena.png"], ["Clinique", "clinique.png"], ["Avène", "avene.png"], ["Mercure Hotel", "mercure.png"],
  ["Pernambucanas", "pernambucanas.png"], ["Color Wow", "color-wow.png"], ["Palmer's", "palmers.png"], ["Kiss New York", "kiss-new-york.png"],
  ["Chico Rei", "chico-rei.png"], ["Beyoung", "beyoung.png"], ["Don Cream", "don-cream.png"], ["Hey Harper", "hey-harper.png"],
  ["White Align", "white-align.png"], ["Panda Alianças", "panda-aliancas.png"], ["Mirante", "mirante.jpg"], ["Boh Gastronomia", "boh-gastronomia.png"],
  ["Authentic Nutri", "marca-a.png"], ["LingoPanda", "marca-panda.png"], ["Deby", "deby-fit.png"], ["Zapia AI", "zapia.png"],
];

const deliverables = [
  { title: "Vídeos UGC", text: "Pra marca usar nos próprios canais e anúncios: roteiro, gravação e edição." },
  { title: "Fotos e carrosséis", text: "Fotos do produto em uso e carrosséis pro feed da marca." },
  { title: "Publi no meu perfil", text: "Reels em collab e stories no @bylorenmartins." },
];
---

<Layout title="Mídia kit — Loren Martins" description="Mídia kit da Loren Martins, criadora UGC: números do Instagram, destaques e marcas atendidas.">
  <main class="kit bg-offwhite pb-16 text-wine-deep">
    <!-- capa -->
    <section class="stripes border-b-[1.5px] border-wine" style="--stripe-w: 40px;">
      <div class="mx-auto grid max-w-[960px] items-end gap-8 px-6 pt-10 md:grid-cols-[1fr_auto]">
        <div class="flex flex-col gap-4 pb-10">
          <span class="w-fit rounded-full border-[1.5px] border-wine bg-offwhite px-3 py-1 text-xs font-bold tracking-[0.1em] text-wine uppercase">Mídia kit</span>
          <h1 class="font-display text-[clamp(3rem,8vw,5rem)] leading-[0.95] text-wine">Loren <span class="italic">Martins</span></h1>
          <p class="text-lg font-semibold text-wine">UGC Creator & Mentora · São José dos Campos (SP)</p>
          <ul class="flex flex-wrap gap-2">
            {niches.map((n) => <li class="rounded-full border-[1.5px] border-wine bg-offwhite px-3 py-1 text-sm text-wine">{n}</li>)}
          </ul>
        </div>
        <div class="relative mx-auto aspect-[4/5] w-[220px] md:w-[260px]">
          <Sparkle class="absolute top-4 -left-10 h-8 w-8 text-wine" />
          <div aria-hidden="true" class="absolute inset-0 translate-x-2.5 rounded-t-[50%_40%] border-x-[1.5px] border-t-[1.5px] border-wine bg-rose"></div>
          <div class="absolute inset-0 overflow-hidden rounded-t-[50%_40%] border-x-[1.5px] border-t-[1.5px] border-wine bg-sky">
            <img src="/images/loren.webp" alt="Loren Martins sorrindo, com a mão apoiada no rosto" class="h-full w-full object-cover" />
          </div>
        </div>
      </div>
    </section>

    <!-- sobre -->
    <section class="kit-block mx-auto max-w-[960px] px-6 pt-12">
      <p class="max-w-3xl text-xl leading-relaxed">
        Sou criadora UGC e especialista em <strong class="text-wine">cases virais e de performance</strong>. Uno estratégia, criatividade e conhecimento de plataformas para criar conteúdos que prendem a atenção, despertam interesse e ajudam marcas a alcançar seus objetivos.
      </p>
    </section>

    <!-- números -->
    <section class="kit-block mx-auto max-w-[960px] px-6 pt-12">
      <h2 class="flex items-center gap-3 font-display text-[clamp(2rem,4vw,2.75rem)] leading-tight text-wine"><Sparkle class="h-6 w-6" /> Números <span class="italic">do perfil</span></h2>
      <p class="mt-2 text-sm text-wine-soft">Instagram @bylorenmartins · últimos 30 dias · dados de {DATA_COLETA}</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
        {stats.map((s, i) => (
          <li class={`flex flex-col gap-1 rounded-[24px] border-[1.5px] border-wine p-5 shadow-[5px_5px_0_var(--color-wine)] ${i % 3 === 0 ? "bg-rose" : i % 3 === 1 ? "bg-sky" : "bg-offwhite"}`}>
            <span class="font-display text-[40px] leading-none text-wine">{s.value}</span>
            <span class="leading-snug">{s.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- destaques -->
    <section class="kit-block mx-auto max-w-[960px] px-6 pt-14">
      <h2 class="flex items-center gap-3 font-display text-[clamp(2rem,4vw,2.75rem)] leading-tight text-wine"><Sparkle class="h-6 w-6" /> Conteúdos <span class="italic">em destaque</span></h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-2">
        {highlights.map((h) => (
          <li class="flex flex-col gap-2 rounded-[24px] border-[1.5px] border-wine bg-offwhite p-5">
            <p class="flex flex-wrap items-baseline gap-x-2"><span class="font-display text-2xl text-wine">{h.title}</span><span class="text-sm font-semibold tracking-[0.06em] text-wine-soft uppercase">{h.detail}</span></p>
            <ul class="flex flex-wrap gap-2">
              {h.numbers.map((n) => <li class="rounded-full bg-rose px-3 py-1 text-sm font-semibold text-wine">{n}</li>)}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    <!-- público -->
    <section class="kit-block mx-auto max-w-[960px] px-6 pt-14">
      <h2 class="flex items-center gap-3 font-display text-[clamp(2rem,4vw,2.75rem)] leading-tight text-wine"><Sparkle class="h-6 w-6" /> Meu <span class="italic">público</span></h2>
      {audience.length > 0 && (
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {audience.map((a) => (
            <div class="rounded-[24px] border-[1.5px] border-wine bg-offwhite p-5">
              <p class="mb-2 font-semibold text-wine">{a.label}</p>
              <ul class="flex flex-col gap-1">{a.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          ))}
        </div>
      )}
      <p class="mt-6 max-w-3xl rounded-[24px] border-[1.5px] border-dashed border-wine bg-sky px-5 py-4 leading-relaxed">
        Meus seguidores ficam mais ativos <strong class="text-wine">das 6h às 15h</strong>, com pico <strong class="text-wine">ao meio-dia</strong> todos os dias. Mais da metade das views vem de quem ainda não me segue: o conteúdo chega a gente nova.
      </p>
    </section>

    <!-- marcas -->
    <section class="kit-block mx-auto max-w-[960px] px-6 pt-14">
      <h2 class="flex items-center gap-3 font-display text-[clamp(2rem,4vw,2.75rem)] leading-tight text-wine"><Sparkle class="h-6 w-6" /> Marcas que <span class="italic">já confiaram</span></h2>
      <ul class="mt-6 grid grid-cols-4 gap-4 sm:grid-cols-6 md:grid-cols-8">
        {logos.map(([name, file]) => (
          <li class="flex justify-center"><img src={`/images/logos/${file}`} alt={name} width="80" height="80" loading="lazy" class="h-16 w-16 rounded-full border border-wine/15 object-cover sm:h-[72px] sm:w-[72px]" /></li>
        ))}
      </ul>
    </section>

    <!-- entregas -->
    <section class="kit-block mx-auto max-w-[960px] px-6 pt-14">
      <h2 class="flex items-center gap-3 font-display text-[clamp(2rem,4vw,2.75rem)] leading-tight text-wine"><Sparkle class="h-6 w-6" /> O que <span class="italic">eu entrego</span></h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {deliverables.map((d) => (
          <li class="flex flex-col gap-2 rounded-[24px] border-[1.5px] border-wine bg-offwhite p-5 shadow-[5px_5px_0_var(--color-wine)]">
            <span class="font-display text-2xl text-wine">{d.title}</span>
            <span class="leading-relaxed">{d.text}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- contato -->
    <section class="kit-block mx-auto mt-14 max-w-[960px] px-6">
      <div class="flex flex-col items-center gap-5 rounded-[32px] border-[1.5px] border-wine bg-wine px-6 py-10 text-center text-offwhite">
        <h2 class="font-display text-[clamp(2rem,4vw,2.75rem)] leading-tight text-rose">Vamos criar <span class="italic text-sky">juntas?</span></h2>
        <div class="flex flex-wrap justify-center gap-3">
          <a href={`https://wa.me/${WHATSAPP}?text=${encodeURIComponent("Oi, Loren! Vi seu mídia kit e quero conversar sobre uma parceria.")}`} target="_blank" rel="noopener noreferrer" class="rounded-full bg-rose px-6 py-3 font-semibold text-wine">WhatsApp</a>
          <a href={`mailto:${EMAIL}`} class="rounded-full border-[1.5px] border-offwhite px-6 py-3 font-semibold">{EMAIL}</a>
          <a href="/portfolio" class="rounded-full border-[1.5px] border-offwhite px-6 py-3 font-semibold">Ver portfólio</a>
        </div>
        <p class="text-sm text-offwhite/80">@bylorenmartins · lorenmartins.com.br</p>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* versão em PDF (Ctrl+P > Salvar como PDF): sem cortar blocos no meio e com as cores de fundo */
  @page { size: A4; margin: 10mm; }
  @media print {
    :global(html), :global(body) { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .kit-block { break-inside: avoid; }
  }
</style>
