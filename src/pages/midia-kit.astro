---
import Layout from '../layouts/Layout.astro';
import Sparkle from '../components/Sparkle.astro';
import VideoFrame from '../components/VideoFrame.astro';

// ===== mídia kit: todos os números ficam aqui, com a data da coleta =====
// fonte: Insights do Instagram @bylorenmartins (versão web), coletados em DATA_COLETA
const DATA_COLETA = "17/11/2026";
const WHATSAPP = "5534991670558";
const EMAIL = "contatolorenmartins@gmail.com";

const niches = ["Moda", "Experiências", "Tech", "Acessórios", "Beleza", "Bem-estar & fit", "Bebidas & drinks", "Pet"];

// visão geral dos últimos 30 dias
const stats = [
  { value: "268,6 mil", label: "views" },
  { value: "79,3 mil", label: "contas alcançadas" },
  { value: "8,26%", label: "de engajamento médio nos Reels" },
  { value: "5,5 mil", label: "visitas ao perfil" },
];

// gráficos (últimos 30 dias). Cores validadas pra daltonismo; todo valor aparece escrito
const C = { wine: "#9B2C44", sky: "#3F86CF", rose: "#E58FA3" };
const viewsAudience = [
  { label: "Não seguidores", value: 52.5, color: C.wine },
  { label: "Seguidores", value: 47.5, color: C.sky },
];
const splits = [
  { title: "Views por formato", parts: [{ label: "Stories", value: 63.3, color: C.wine }, { label: "Reels", value: 36.7, color: C.sky }] },
  { title: "Interações por formato", parts: [{ label: "Reels", value: 58.3, color: C.wine }, { label: "Stories", value: 39.2, color: C.sky }, { label: "Posts", value: 2.5, color: C.rose }] },
];
// seguidores ativos por horário: média dos 7 dias (insights do Instagram)
const activeByDay = {
  "0h": [451, 546, 532, 552, 528, 402, 310], "3h": [1202, 1260, 1271, 1283, 1276, 1133, 1017],
  "6h": [1462, 1486, 1496, 1522, 1516, 1447, 1392], "9h": [1468, 1466, 1469, 1500, 1489, 1429, 1416],
  "12h": [1514, 1515, 1530, 1554, 1533, 1440, 1463], "15h": [1465, 1475, 1466, 1491, 1482, 1412, 1456],
  "18h": [831, 837, 851, 881, 1000, 988, 909], "21h": [214, 208, 215, 226, 290, 311, 240],
};
const hours = Object.entries(activeByDay).map(([h, v]) => ({ h, avg: Math.round(v.reduce((a, b) => a + b, 0) / v.length) }));
const maxHour = Math.max(...hours.map((x) => x.avg));
const fmt = (n: number) => n.toLocaleString("pt-BR", { maximumFractionDigits: 1 });

// donut: 2px de folga entre as fatias
const R = 54, CIRC = 2 * Math.PI * R;
let acc = 0;
const donut = viewsAudience.map((p) => {
  const len = (p.value / 100) * CIRC;
  const seg = { ...p, dash: `${Math.max(len - 3, 0)} ${CIRC}`, offset: -acc };
  acc += len;
  return seg;
});

// publis e collabs: `src` = vídeo em public/videos (com a capa .jpg do mesmo nome); sem `src`, fica o espaço reservado
// `tipo`: "Publi" (parceria paga), "Collab" ou "UGC"; `views` só quando o número veio dos insights do próprio Reel
type Publi = { brand: string; tipo?: string; src?: string; views?: string };
const publis: Publi[] = [
  { brand: "Mercure Hotel", tipo: "Collab", src: "/videos/experiencias-mercure.mp4" },
  { brand: "Mirante", tipo: "Collab", src: "/videos/moda-mirante.mp4", views: "33 mil views" },
  { brand: "Disney+", tipo: "Publi", views: "16,1 mil views" },
  { brand: "Boh Gastronomia", tipo: "Collab", src: "/videos/experiencias-boh.mp4", views: "35,9 mil views" },
  { brand: "Banho Premium", tipo: "Publi" },
  { brand: "Panda Alianças", tipo: "Collab", src: "/videos/moda-panda-aliancas.mp4" },
  { brand: "Color Wow", src: "/videos/autocuidado-color-wow.mp4" },
  { brand: "Loungerie", src: "/videos/moda-loungerie.mp4" },
  { brand: "Deby Alimentação Saudável", tipo: "Collab", src: "/videos/bem-estar-marmitas-deby.mp4" },
  { brand: "Authentic Nutri", src: "/videos/bem-estar-authentic-nutri.mp4" },
  { brand: "Thermolife", src: "/videos/lifestyle-thermolife.mp4" },
  { brand: "Parceria como influenciadora", tipo: "Em breve" },
  { brand: "Parceria como influenciadora", tipo: "Em breve" },
];
const poster = (src?: string) => src?.replace(/\.mp4$/, ".jpg");

const deliverables = [
  { title: "Vídeos UGC", text: "Pra marca usar nos próprios canais e anúncios: roteiro, gravação e edição." },
  { title: "Fotos e carrosséis", text: "Fotos do produto em uso e carrosséis pro feed da marca." },
  { title: "Publi no meu perfil", text: "Reels em collab e stories no @bylorenmartins." },
];
---

<Layout title="Mídia kit — Loren Martins" description="Mídia kit da Loren Martins, criadora UGC: números do Instagram, destaques e marcas atendidas.">
  <main class="kit bg-offwhite pb-16 text-wine-deep">
    <!-- capa -->
    <section class="stripes border-b-[1.5px] border-wine" style="--stripe-w: 40px;">
      <div class="mx-auto grid max-w-[960px] items-end gap-8 px-6 pt-10 md:grid-cols-[1fr_auto]">
        <div class="flex flex-col gap-4 pb-10">
          <span class="w-fit rounded-full border-[1.5px] border-wine bg-offwhite px-3 py-1 text-xs font-bold tracking-[0.1em] text-wine uppercase">Mídia kit</span>
          <h1 class="font-display text-[clamp(3rem,8vw,5rem)] leading-[0.95] text-wine">Loren <span class="italic">Martins</span></h1>
          <p class="text-lg font-semibold text-wine">UGC Creator & Mentora · São José dos Campos (SP)</p>
          <ul class="flex flex-wrap gap-2">
            {niches.map((n) => <li class="rounded-full border-[1.5px] border-wine bg-offwhite px-3 py-1 text-sm text-wine">{n}</li>)}
          </ul>
        </div>
        <div class="relative mx-auto aspect-[4/5] w-[220px] md:w-[260px]">
          <Sparkle class="absolute top-4 -left-10 h-8 w-8 text-wine" />
          <div aria-hidden="true" class="absolute inset-0 translate-x-2.5 rounded-t-[50%_40%] border-x-[1.5px] border-t-[1.5px] border-wine bg-rose"></div>
          <div class="absolute inset-0 overflow-hidden rounded-t-[50%_40%] border-x-[1.5px] border-t-[1.5px] border-wine bg-sky">
            <img src="/images/loren.webp" alt="Loren Martins sorrindo, com a mão apoiada no rosto" class="h-full w-full object-cover" />
          </div>
        </div>
      </div>
    </section>

    <!-- sobre -->
    <section class="kit-block mx-auto max-w-[960px] px-6 pt-12">
      <p class="max-w-3xl text-xl leading-relaxed">
        Sou criadora UGC e especialista em <strong class="text-wine">cases virais e de performance</strong>. Uno estratégia, criatividade e conhecimento de plataformas para criar conteúdos que prendem a atenção, despertam interesse e ajudam marcas a alcançar seus objetivos.
      </p>
    </section>

    <!-- números -->
    <section class="kit-block mx-auto max-w-[960px] px-6 pt-12">
      <h2 class="flex items-center gap-3 font-display text-[clamp(2rem,4vw,2.75rem)] leading-tight text-wine"><Sparkle class="h-6 w-6" /> Números <span class="italic">do perfil</span></h2>
      <p class="mt-2 text-sm text-wine-soft">Instagram @bylorenmartins · últimos 30 dias · dados de {DATA_COLETA}</p>
      <ul class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4">
        {stats.map((s, i) => (
          <li class={`flex flex-col gap-1 rounded-[24px] border-[1.5px] border-wine p-5 shadow-[5px_5px_0_var(--color-wine)] ${i % 2 === 0 ? "bg-rose" : "bg-sky"}`}>
            <span class="font-display text-[clamp(1.9rem,4vw,2.5rem)] leading-none text-wine">{s.value}</span>
            <span class="leading-snug">{s.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- gráficos -->
    <section class="kit-block mx-auto max-w-[960px] px-6 pt-8">
      <div class="grid gap-4 md:grid-cols-[1fr_1.4fr]">
        <!-- donut: de onde vêm as views -->
        <figure class="flex flex-col gap-4 rounded-[24px] border-[1.5px] border-wine bg-offwhite p-5">
          <figcaption class="font-semibold text-wine">De onde vêm as views</figcaption>
          <div class="flex items-center gap-5">
            <svg viewBox="0 0 140 140" class="h-36 w-36 shrink-0 -rotate-90" role="img" aria-label="Views: 52,5% de não seguidores e 47,5% de seguidores">
              {donut.map((d) => (
                <circle cx="70" cy="70" r={R} fill="none" stroke={d.color} stroke-width="22" stroke-dasharray={d.dash} stroke-dashoffset={d.offset} stroke-linecap="butt"><title>{d.label}: {fmt(d.value)}%</title></circle>
              ))}
            </svg>
            <ul class="flex flex-col gap-3">
              {viewsAudience.map((d) => (
                <li class="flex items-start gap-2">
                  <span aria-hidden="true" class="mt-1.5 h-3 w-3 shrink-0 rounded-[3px]" style={`background:${d.color}`}></span>
                  <span><span class="block font-display text-3xl leading-none text-wine">{fmt(d.value)}%</span><span class="text-sm">{d.label}</span></span>
                </li>
              ))}
            </ul>
          </div>
          <p class="text-sm text-wine-soft">Mais da metade das views vem de quem ainda não me segue.</p>
        </figure>

        <!-- barras empilhadas: formatos -->
        <div class="flex flex-col gap-4 rounded-[24px] border-[1.5px] border-wine bg-offwhite p-5">
          {splits.map((sp) => (
            <figure class="flex flex-col gap-2.5">
              <figcaption class="font-semibold text-wine">{sp.title}</figcaption>
              <div class="flex h-7 w-full gap-[2px] overflow-hidden rounded-[6px]" role="img" aria-label={`${sp.title}: ${sp.parts.map((p) => `${p.label} ${fmt(p.value)}%`).join(", ")}`}>
                {sp.parts.map((p) => <span class="h-full" style={`width:${p.value}%;background:${p.color}`} title={`${p.label}: ${fmt(p.value)}%`}></span>)}
              </div>
              <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
                {sp.parts.map((p) => (
                  <li class="flex items-center gap-1.5"><span aria-hidden="true" class="h-3 w-3 rounded-[3px]" style={`background:${p.color}`}></span>{p.label} <strong class="text-wine">{fmt(p.value)}%</strong></li>
                ))}
              </ul>
            </figure>
          ))}
        </div>
      </div>

      <!-- barras: horários -->
      <figure class="mt-4 rounded-[24px] border-[1.5px] border-wine bg-offwhite p-5">
        <figcaption class="font-semibold text-wine">Quando meus seguidores estão online <span class="font-normal text-wine-soft">· média por horário</span></figcaption>
        <div class="mt-4 flex h-44 items-end gap-2 border-b-[1.5px] border-wine/30 sm:gap-4" role="img" aria-label={`Seguidores ativos por horário: ${hours.map((x) => `${x.h} ${x.avg}`).join(", ")}`}>
          {hours.map((x) => (
            <div class="flex h-full flex-1 flex-col items-center justify-end gap-1" title={`${x.h}: ${fmt(x.avg)} seguidores ativos`}>
              {x.avg === maxHour && <span class="text-xs font-bold text-wine">pico</span>}
              <span class="w-full max-w-[56px] rounded-t-[4px]" style={`height:${(x.avg / maxHour) * 82}%;background:${x.avg === maxHour ? C.wine : C.rose}`}></span>
            </div>
          ))}
        </div>
        <div class="mt-1.5 flex gap-2 text-center text-xs text-wine-soft sm:gap-4">
          {hours.map((x) => <span class="flex-1">{x.h}</span>)}
        </div>
        <p class="mt-3 text-sm text-wine-soft">Atividade alta das 6h às 15h, com pico ao meio-dia todos os dias.</p>
      </figure>
    </section>

    <!-- publis -->
    <section class="kit-publis mx-auto max-w-[960px] px-6 pt-14">
      <h2 class="flex items-center gap-3 font-display text-[clamp(2rem,4vw,2.75rem)] leading-tight text-wine"><Sparkle class="h-6 w-6" /> Publis <span class="italic">e collabs</span></h2>
      <p class="kit-print-only mt-2 text-sm text-wine-soft">Assista aos vídeos em lorenmartins.com.br/midia-kit</p>
      <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 md:grid-cols-4">
        {publis.map((v) => (
          <li class="kit-block flex flex-col gap-2">
            <VideoFrame label={v.src ? v.brand : `Vídeo em breve`} src={v.src} poster={poster(v.src)} badge={v.views} class="rounded-[18px]" />
            <p class="flex flex-wrap items-center gap-x-2 gap-y-1 leading-tight">
              <span class="font-display text-lg text-wine">{v.brand}</span>
              {v.tipo && <span class="rounded-full bg-sky px-2 py-0.5 text-[11px] font-bold tracking-[0.06em] text-wine uppercase">{v.tipo}</span>}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <!-- entregas -->
    <section class="kit-block mx-auto max-w-[960px] px-6 pt-14">
      <h2 class="flex items-center gap-3 font-display text-[clamp(2rem,4vw,2.75rem)] leading-tight text-wine"><Sparkle class="h-6 w-6" /> O que <span class="italic">eu entrego</span></h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {deliverables.map((d) => (
          <li class="flex flex-col gap-2 rounded-[24px] border-[1.5px] border-wine bg-offwhite p-5 shadow-[5px_5px_0_var(--color-wine)]">
            <span class="font-display text-2xl text-wine">{d.title}</span>
            <span class="leading-relaxed">{d.text}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- contato -->
    <section class="kit-block mx-auto mt-14 max-w-[960px] px-6">
      <div class="flex flex-col items-center gap-5 rounded-[32px] border-[1.5px] border-wine bg-wine px-6 py-10 text-center text-offwhite">
        <h2 class="font-display text-[clamp(2rem,4vw,2.75rem)] leading-tight text-rose">Vamos criar <span class="italic text-sky">juntas?</span></h2>
        <div class="flex flex-wrap justify-center gap-3">
          <a href={`https://wa.me/${WHATSAPP}?text=${encodeURIComponent("Oi, Loren! Vi seu mídia kit e quero conversar sobre uma parceria.")}`} target="_blank" rel="noopener noreferrer" class="rounded-full bg-rose px-6 py-3 font-semibold text-wine">WhatsApp</a>
          <a href={`mailto:${EMAIL}`} class="rounded-full border-[1.5px] border-offwhite px-6 py-3 font-semibold">{EMAIL}</a>
          <a href="/portfolio" class="rounded-full border-[1.5px] border-offwhite px-6 py-3 font-semibold">Ver portfólio</a>
        </div>
        <p class="text-sm text-offwhite/80">@bylorenmartins · lorenmartins.com.br</p>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* versão em PDF (Ctrl+P > Salvar como PDF): sem cortar blocos no meio e com as cores de fundo */
  @page { size: A4; margin: 10mm; }
  .kit-print-only { display: none; }
  @media print {
    .kit-print-only { display: block; }
    :global(html), :global(body) { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .kit-block { break-inside: avoid; }
    .kit-publis { break-before: page; }
    :global([data-video-play]) { display: none !important; }
  }
</style>
