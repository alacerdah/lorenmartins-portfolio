---
// foto com fallback: sem `src` mostra um espaço reservado com a legenda, pra o layout
// já ficar certo antes das fotos chegarem. Formato e cantos vêm pela `class` de quem usa.
interface Props {
  src?: string;
  alt: string;
  label?: string;
  class?: string;
  eager?: boolean;
}
const { src, alt, label = alt, class: className = "", eager = false } = Astro.props;
---
{src ? (
  <img src={src} alt={alt} class={`object-cover ${className}`} loading={eager ? "eager" : "lazy"} />
) : (
  <div
    role="img"
    aria-label={alt}
    class={`flex flex-col items-center justify-center gap-2 text-center text-wine ${className}`}
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 8h3l2-3h6l2 3h3v11H4z" />
      <circle cx="12" cy="13" r="3.5" />
    </svg>
    <span class="px-3 text-xs font-semibold tracking-[0.12em] uppercase">{label}</span>
  </div>
)}
