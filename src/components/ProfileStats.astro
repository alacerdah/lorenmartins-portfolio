---
// seção "Mídia kit" do portfólio: números do Instagram + redes. Todos os números ficam aqui, com a data da coleta.
// fonte: Insights do Instagram @bylorenmartins (versão web). Atualize os números e a DATA juntos.
import Sparkle from './Sparkle.astro';

interface Props {
  lang?: "pt" | "en";
  whatsapp: string;
  email: string;
  instagram: string;
  tiktok: string;
}
const { lang = "pt", whatsapp, email, instagram, tiktok } = Astro.props;
const t = (pt: string, en: string) => (lang === "en" ? en : pt);
const fmt = (n: number) => n.toLocaleString(lang === "en" ? "en-US" : "pt-BR", { maximumFractionDigits: 1 });

const DATA = { pt: "17/11/2026", en: "Nov 17, 2026" };
const followers = 2987;

// últimos 30 dias
const stats: { value: string; label: string; sub?: string[] }[] = [
  { value: t("268,6 mil", "268.6K"), label: t("views", "views"), sub: [t("52,5% de não seguidores", "52.5% from non-followers"), t("47,5% de seguidores", "47.5% from followers")] },
  { value: t("79,3 mil", "79.3K"), label: t("contas alcançadas", "accounts reached") },
  { value: t("12,6 mil", "12.6K"), label: t("interações", "interactions") },
  { value: t("8,26%", "8.26%"), label: t("taxa de engajamento nos Reels", "Reels engagement rate") },
];

// cores validadas pra daltonismo (paleta da marca um pouco mais forte); todo valor aparece escrito
const C = { wine: "#9B2C44", sky: "#3F86CF", rose: "#E58FA3" };
// público (app do Instagram > Painel > Público)
const gender = [
  { label: t("Homens", "Men"), value: 7.4, color: C.sky },
  { label: t("Mulheres", "Women"), value: 92.6, color: C.wine },
];
const ages = [
  { label: "13–17", value: 0.6 }, { label: "18–24", value: 17.1 }, { label: "25–34", value: 56.8 }, { label: "35–44", value: 17.1 },
  { label: "45–54", value: 5.6 }, { label: "55–64", value: 2.4 }, { label: "65+", value: 0.5 },
];
// faixa etária em pizza: as 3 maiores faixas + o resto junto (fatia neutra)
const ageParts = [
  { label: "18–24", value: 17.1, color: C.sky },
  { label: "35–44", value: 17.1, color: C.rose },
  { label: t("outras", "other"), value: 9.1, color: "#E3D6C8" },
  { label: "25–34", value: 56.8, color: C.wine },
];
const cities = [
  { label: "São Paulo", value: 10.0 }, { label: "São José dos Campos", value: 8.5 }, { label: "Uberlândia", value: 6.4 },
  { label: "Rio de Janeiro", value: 4.0 }, { label: "Belo Horizonte", value: 1.8 },
];
// região em pizza: as 3 maiores cidades + o resto do público junto (cores validadas; a fatia "outras" é neutra)
const regionParts = [
  { label: "São Paulo", value: 10.0, color: C.wine },
  { label: "São José", value: 8.5, color: C.sky },
  { label: "Uberlândia", value: 6.4, color: C.rose },
  { label: t("outras", "other"), value: 75.1, color: "#E3D6C8" },
];
const countries = [
  { label: t("Brasil", "Brazil"), value: 92.2 }, { label: "Portugal", value: 2.0 }, { label: t("Estados Unidos", "United States"), value: 1.7 },
];

// pizza com rótulo fora de cada fatia (como na referência). Ângulos em graus, sentido horário a partir do topo;
// `start` gira a pizza pra deixar as fatias pequenas onde os rótulos têm espaço
type Part = { label: string; value: number; color: string };
const PIE = { w: 480, h: 290, cx: 240, cy: 145, r: 100, inner: 58, labelR: 126 };
const pt = (deg: number, r: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [PIE.cx + r * Math.cos(a), PIE.cy + r * Math.sin(a)];
};
const pie = (parts: Part[], start: number) => {
  let acc = start;
  return parts.map((p) => {
    const a0 = acc, a1 = acc + (p.value / 100) * 360;
    acc = a1;
    const gap = 0.8; // folga entre fatias
    const [x0, y0] = pt(a0 + gap, PIE.r), [x1, y1] = pt(a1 - gap, PIE.r);
    const [x2, y2] = pt(a1 - gap, PIE.inner), [x3, y3] = pt(a0 + gap, PIE.inner);
    const big = a1 - a0 > 180 ? 1 : 0;
    const d = `M${x0} ${y0}A${PIE.r} ${PIE.r} 0 ${big} 1 ${x1} ${y1}L${x2} ${y2}A${PIE.inner} ${PIE.inner} 0 ${big} 0 ${x3} ${y3}Z`;
    const mid = (a0 + a1) / 2;
    const [lx, ly] = pt(mid, PIE.labelR);
    const side = Math.sin((mid * Math.PI) / 180);
    const anchor = side > 0.25 ? "start" : side < -0.25 ? "end" : "middle";
    return { ...p, d, lx, ly, anchor };
  });
};

const handle = "@bylorenmartins";
const networks = [
  { name: "Instagram", sub: handle, href: instagram, icon: "M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zM12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM17.5 6.5h.01" },
  { name: "TikTok", sub: handle, href: tiktok, icon: "M9 12a4 4 0 1 0 4 4V3c.5 2.5 2.5 4.5 5 5" },
  { name: "WhatsApp", sub: t("resposta rápida", "quick reply"), href: `https://wa.me/${whatsapp}`, icon: "M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.6A8.4 8.4 0 1 1 21 11.5z" },
  { name: "E-mail", sub: email, href: `mailto:${email}`, icon: "M3 6h18v12H3zM3 7l9 6 9-6" },
];
const card = "rounded-[28px] border-[1.5px] border-wine bg-offwhite p-5 sm:p-7";
---

<section id="midia-kit" class="scroll-mt-20 border-b-[1.5px] border-wine bg-rose px-6 py-14 sm:py-16">
  <div class="mx-auto flex max-w-[1320px] flex-col gap-8">
    <div data-reveal class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="font-display text-[clamp(2.25rem,4vw,3.5rem)] leading-none text-wine">{t("Mídia", "Media")} <span class="italic">kit</span></h2>
      <p class="max-w-md leading-relaxed">{t("Além do UGC, também crio como influenciadora. Estes são os números do meu perfil.", "Besides UGC, I also create as an influencer. These are my profile numbers.")}</p>
    </div>

    <div class="grid gap-6 xl:grid-cols-[1.7fr_1fr]">
      <!-- Instagram -->
      <div data-reveal class={`hard-shadow ${card} flex flex-col gap-6`}>
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="flex items-center gap-2 font-semibold text-wine"><Sparkle class="h-4 w-4" /> Instagram</p>
            <a href={instagram} target="_blank" rel="noopener noreferrer" class="font-display text-[clamp(1.75rem,3vw,2.25rem)] leading-tight text-wine italic">{handle}</a>
          </div>
          <div class="text-right">
            <p class="text-xs font-semibold tracking-[0.12em] text-wine-soft uppercase">{t("Seguidores", "Followers")}</p>
            <p class="font-display text-4xl leading-none text-wine">{fmt(followers)}</p>
          </div>
        </div>

        <div>
          <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            {stats.map((s, i) => (
              <li class={`flex flex-col gap-1 rounded-2xl border-[1.5px] border-wine px-4 py-3 ${i % 2 === 0 ? "bg-rose" : "bg-sky"}`}>
                <span class="font-display text-[24px] leading-none whitespace-nowrap text-wine sm:text-[28px]">{s.value}</span>
                <span class="text-sm leading-snug">{s.label}</span>
                {s.sub && <span class="text-xs leading-snug text-wine-soft">{s.sub.map((x) => <span class="block">{x}</span>)}</span>}
              </li>
            ))}
          </ul>
          <p class="mt-2 text-xs text-wine-soft">{t(`Insights do Instagram · últimos 30 dias · dados de ${DATA.pt}`, `Instagram Insights · last 30 days · data from ${DATA.en}`)}</p>
        </div>

        <!-- gênero, faixa etária e região: pizzas do mesmo tamanho, rótulo em volta e título embaixo -->
        <div class="grid gap-8 border-t-[1.5px] border-wine/15 pt-6 sm:grid-cols-3 sm:gap-4">
          {[
            { title: t("Faixa etária", "Age range"), slices: pie(ageParts, 20), note: `${t("outras", "other")}: ${ages.filter((a) => !["18–24", "25–34", "35–44"].includes(a.label)).map((a) => `${a.label} ${fmt(a.value)}%`).join(" · ")}` },
            { title: t("Gênero", "Gender"), slices: pie(gender, 333), note: "" },
            { title: t("Região", "Location"), slices: pie(regionParts, 28), note: `${t("São José = São José dos Campos", "São José = São José dos Campos")} · ${t("Brasil", "Brazil")} ${fmt(countries[0].value)}%` },
          ].map((d) => (
            <figure class="flex flex-col items-center text-center">
              <svg viewBox={`0 0 ${PIE.w} ${PIE.h}`} class="w-full max-w-[340px] overflow-visible" role="img" aria-label={`${d.title}: ${d.slices.map((p) => `${p.label} ${fmt(p.value)}%`).join(", ")}`}>
                {d.slices.map((p) => <path d={p.d} fill={p.color}><title>{p.label}: {fmt(p.value)}%</title></path>)}
                {d.slices.map((p) => (
                  <text x={p.lx} y={p.ly - 4} text-anchor={p.anchor} class="fill-wine" style="font-size:25px;font-weight:700;font-style:italic">
                    <tspan x={p.lx}>{p.label}</tspan>
                    <tspan x={p.lx} dy="27">{fmt(p.value)}%</tspan>
                  </text>
                ))}
              </svg>
              <figcaption class="mt-1 font-display text-2xl text-wine">{d.title}</figcaption>
              {d.note && <p class="text-sm text-wine-soft italic">{d.note}</p>}
            </figure>
          ))}
        </div>

        <a href={instagram} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 w-fit items-center gap-2 rounded-full bg-wine px-6 font-semibold text-offwhite transition-transform hover:-translate-y-0.5">
          {t("Seguir no Instagram", "Follow on Instagram")}
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>

      <!-- redes -->
      <div data-reveal style="--reveal-delay: 100ms;" class={`hard-shadow ${card} flex flex-col gap-4 self-start`}>
        <p class="flex items-center gap-2 font-semibold text-wine"><Sparkle class="h-4 w-4" /> {t("Onde me encontrar", "Where to find me")}</p>
        <ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-1">
          {networks.map((n) => (
            <li>
              <a href={n.href} target={n.href.startsWith("http") ? "_blank" : undefined} rel={n.href.startsWith("http") ? "noopener noreferrer" : undefined} class="flex items-center gap-3 rounded-2xl border-[1.5px] border-wine/20 bg-white/60 px-4 py-3 transition-colors hover:border-wine">
                <span aria-hidden="true" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-sky text-wine">
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={n.icon} /></svg>
                </span>
                <span class="min-w-0"><span class="block font-semibold text-wine">{n.name}</span><span class="block truncate text-sm text-wine-soft">{n.sub}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
